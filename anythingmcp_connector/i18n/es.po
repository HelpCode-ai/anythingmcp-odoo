#. module: anythingmcp_connector
#: model_terms:ir.ui.view,arch_db:anythingmcp_connector.res_config_settings_view_form
msgid "AI Assistants"
msgstr "Asistentes de IA"

#. module: anythingmcp_connector
#: model_terms:ir.ui.view,arch_db:anythingmcp_connector.res_config_settings_view_form
msgid "AnythingMCP then shows how to add it to Claude, ChatGPT or Copilot."
msgstr "AnythingMCP te muestra después cómo añadirlo a Claude, ChatGPT o Copilot."

#. module: anythingmcp_connector
#: model_terms:ir.ui.view,arch_db:anythingmcp_connector.res_config_settings_view_form
msgid ""
"Ask your AI assistant about invoices, sales orders, customers and products "
"in this Odoo, through AnythingMCP."
msgstr "Pregunta a tu asistente de IA por facturas, pedidos de venta, clientes y productos de este Odoo, a través de AnythingMCP."

#. module: anythingmcp_connector
#: model_terms:ir.ui.view,arch_db:anythingmcp_connector.res_config_settings_view_form
msgid "Claude, ChatGPT and Copilot"
msgstr "Claude, ChatGPT y Copilot"

#. module: anythingmcp_connector
#: model_terms:ir.ui.view,arch_db:anythingmcp_connector.res_config_settings_view_form
msgid "Create an API key"
msgstr "Crear una clave API"

#. module: anythingmcp_connector
#: model_terms:ir.ui.view,arch_db:anythingmcp_connector.res_config_settings_view_form
msgid ""
"Create an API key for your user. Choose the longest duration offered: Odoo "
"shows the key only once."
msgstr "Crea una clave API para tu usuario. Elige la duración más larga disponible: Odoo muestra la clave una sola vez."

#. module: anythingmcp_connector
#: model:ir.model.fields,field_description:anythingmcp_connector.field_res_config_settings__anythingmcp_database
msgid "Database name"
msgstr "Nombre de la base de datos"

#. module: anythingmcp_connector
#: model:ir.model.fields,field_description:anythingmcp_connector.field_res_config_settings__anythingmcp_odoo_url
msgid "Odoo address"
msgstr "Dirección de Odoo"

#. module: anythingmcp_connector
#: model_terms:ir.ui.view,arch_db:anythingmcp_connector.res_config_settings_view_form
msgid "Open AnythingMCP"
msgstr "Abrir AnythingMCP"

#. module: anythingmcp_connector
#: model_terms:ir.ui.view,arch_db:anythingmcp_connector.res_config_settings_view_form
msgid ""
"Open AnythingMCP. The address and database are already filled in: paste the "
"key and click \"Check and install\"."
msgstr "Abre AnythingMCP. La dirección y la base de datos ya están rellenadas: pega la clave y haz clic en \"Check and install\"."

#. module: anythingmcp_connector
#: model:ir.model.fields,field_description:anythingmcp_connector.field_res_config_settings__anythingmcp_user_id
msgid "User ID"
msgstr "ID de usuario"
